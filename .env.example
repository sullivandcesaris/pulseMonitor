APP_NAME=PulseMonitor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
VITE_PORT=5173
WWWUSER=1000
WWWGROUP=1000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pulsemonitor
DB_USERNAME=pulsemonitor
DB_PASSWORD=secret
FORWARD_DB_PORT=5432

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pulsemonitor.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

MONITOR_ALLOWED_PORTS=80,443
MONITOR_CONNECT_TIMEOUT=10
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=1
MONITOR_RETRY_INFRASTRUCTURE_FAILURES=true

# Optional error tracking and metrics integrations.
SENTRY_LARAVEL_DSN=
PROMETHEUS_ENABLED=false
