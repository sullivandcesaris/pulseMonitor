APP_NAME=PulseMonitor
APP_ENV=production
APP_KEY=generate-a-long-random-key
APP_DEBUG=false
APP_URL=https://monitor.example.com
APP_DOMAIN=monitor.example.com
ACME_EMAIL=ops@example.com

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_LEVEL=notice

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=pulsemonitor
DB_USERNAME=pulsemonitor
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECT_TIMEOUT=3

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alerts@example.com
MAIL_FROM_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
PROMETHEUS_ENABLED=true
HORIZON_ADMIN_EMAIL=ops@example.com
